# ==============================================================================
# CLUBE DAS RAPOSINHAS - VARIÁVEIS DE AMBIENTE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NOVO PROJETO FIREBASE (ISOLADO)
# IMPORTANTE: Crie um NOVO projeto no Firebase Console (https://console.firebase.google.com)
# Sugestão de nome: "clube-das-raposinhas" ou "raposinhas-prod"
# NÃO reutilize nem interfira em projetos existentes!
# Ative:
# - Authentication (Provedor: E-mail/Senha)
# - Cloud Firestore (Modo de Produção com as Security Rules do README)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyD_PLACEHOLDER_NOVO_PROJETO"
VITE_FIREBASE_AUTH_DOMAIN="clube-das-raposinhas-novo.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="clube-das-raposinhas-novo"
VITE_FIREBASE_STORAGE_BUCKET="clube-das-raposinhas-novo.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000"

# Compatibilidade caso utilize Next.js / Vercel
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyD_PLACEHOLDER_NOVO_PROJETO"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="clube-das-raposinhas-novo.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="clube-das-raposinhas-novo"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="clube-das-raposinhas-novo.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000"

# ------------------------------------------------------------------------------
# 2. VERCEL BLOB STORAGE (Upload de Imagens de Capa e Áudios MP3/WAV)
# Gere seu token no painel da Vercel em Storage -> Blob -> Tokens
# ------------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_PLACEHOLDER_TOKEN"

# ------------------------------------------------------------------------------
# 3. INFINITEPAY (Gateway de Pagamento Pix e Cartão de Crédito)
# ------------------------------------------------------------------------------
INFINITEPAY_API_KEY="inf_api_live_PLACEHOLDER"
INFINITEPAY_WEBHOOK_SECRET="inf_whsec_PLACEHOLDER"

# ------------------------------------------------------------------------------
# 4. CONFIGURAÇÃO GERAL DO APLICATIVO
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"
PORT=3000
